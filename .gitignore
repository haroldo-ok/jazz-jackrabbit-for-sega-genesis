# SGDK build output
out/

# Test scratch area (emulator core clone/build, intermediate ROMs, binaries)
tests/.tmp/

# Editor/OS noise
*.swp
.DS_Store

# SGDK-generated resource header (built from res/jj1_sounds.res)
res/jj1_sounds.h
res/jj1_music.h

# Assets converted from the shareware game data.  Anyone building this needs
# their own legal copy of Jazz Jackrabbit; regenerate with:
#   python3 tools/build_sgdk_jj1_visuals.py --input <install> --level LEVEL0.000 \
#       --world 000 --output src/jj1_visuals.inc
#   python3 tools/build_sgdk_jj1_level_data.py --input <install> --level LEVELn.000 \
#       --name jj1_leveln --output src/jj1_leveln_data.inc \
#       --eventset src/jj1_leveln_eventset.inc
# Uncomment these if you would rather not carry Epic's converted art in git.
#src/jj1_visuals.inc
#src/jj1_level*_data.inc
#src/jj1_level*_eventset.inc

# Converted soundtrack (VGM) from your own game data, via
# github.com/haroldo-ok/convert-s3m-vgm-jazzjackrabbit-md.  Uncomment to keep
# the audio out of a public repo and have contributors supply their own.
#res/music/*.vgm

# Local SGDK boot files and generated scene resource header
src/boot/
tools/__pycache__/

# Episodes 2-9 and Holiday Hare come from the registered/CD game, so they are
# not kept in git: anyone with their own copy regenerates them with
#   python3 tools/build_packs.py generate --input <JAZZ dir>
# Episode 1 (shareware) stays checked in under packs/ep1.
packs/ep[2-9]/
packs/ep10/
# The episode-selection screen (from the full game's MENU.000)
packs/menu/
# Converted music (made from the game's modules by tools/build_lite.py)
packs/music/
# XGM files from tools/build_music.py (the cartridge's tracks are in packs/music)
res/music/*.xgm
# rescomp headers
res/*.h
