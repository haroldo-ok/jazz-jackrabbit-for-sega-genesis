// Lite cartridge (make lite): same resource as res/, see tools/build_lite.py.
// Every episode plays episode 1's three bonus levels.
BIN jj1_bonus_tiles   "bonus/tiles.bin"
BIN jj1_bonus_tiles_hi "bonus/tiles_hi.bin"
BIN jj1_bonus_masks   "bonus/masks.bin"
BIN jj1_bonus_bg      "bonus/bg.bin"
BIN jj1_bonus_grid0   "../packs/ep1/bonus_grid0.bin"
BIN jj1_bonus_grid1   "../packs/ep1/bonus_grid1.bin"
BIN jj1_bonus_grid2   "../packs/ep1/bonus_grid2.bin"
BIN jj1_bonus_events0 "../packs/ep1/bonus_events0.bin"
BIN jj1_bonus_events1 "../packs/ep1/bonus_events1.bin"
BIN jj1_bonus_events2 "../packs/ep1/bonus_events2.bin"
